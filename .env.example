# --- App ---
NEXT_PUBLIC_SITE_URL=https://cristiangiudici.com

# --- Base de datos (PostgreSQL: Supabase, Neon, RDS, local...) ---
DATABASE_URL=postgres://user:password@host:5432/giudici

# --- Mercado Pago ---
# Access token de PRODUCCIÓN o TEST de la cuenta vendedora
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxx
# Clave secreta de webhooks (Tus integraciones > Webhooks > "Clave secreta")
MP_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx
# Moneda de la cuenta vendedora. Cuenta argentina: MP cobra en ARS. Para cobrar en USD hace falta una cuenta de MP en un país que lo permita (ej. Uruguay). Ver README.
MP_CURRENCY=USD
# Solo si MP_CURRENCY != USD: cuántas unidades de esa moneda vale 1 USD (ej. 1450 para ARS)
MP_USD_RATE=1

# --- Email (Resend) ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
EMAIL_FROM="Cristian Giudici <rutinas@cristiangiudici.com>"
EMAIL_ADMIN=cristian@cristiangiudici.com

# --- Asesoría ---
NEXT_PUBLIC_CAL_URL=https://cal.com/cristian-giudici/evaluacion-inicial
